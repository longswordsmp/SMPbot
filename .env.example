# ── SMPbot environment configuration ─────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit your real .env file.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your application (client) ID from the developer portal
CLIENT_ID=

# Optional: register slash commands to a single guild for instant
# updates while developing. Leave empty to register globally.
DEV_GUILD_ID=

# Optional: comma-separated Discord user IDs that may use bot-owner
# commands regardless of guild permissions.
OWNER_IDS=

# Set to true to automatically register slash commands every time the bot
# starts (recommended for hosted deployments like Railway — no local
# `npm run deploy` needed).
AUTO_DEPLOY_COMMANDS=true
